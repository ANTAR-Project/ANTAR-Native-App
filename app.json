{
  "expo": {
    "name": "ANTAR",
    "slug": "ANTAR",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/antar-logo.png",
    "scheme": "antar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090A0D",
    "ios": {
      "icon": "./assets/images/antar-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/antar-logo.png",
        "backgroundImage": "./assets/images/antar-logo.png",
        "monochromeImage": "./assets/images/antar-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.antar.ANTAR"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/antar-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A0D",
          "image": "./assets/images/antar-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fb3a3456-5c05-4302-8d12-965f253d689b"
      }
    }
  }
}